# OmniInvoice UAE - Environment Configuration Template
# Working Product Name (Configurable across entire SaaS)
NEXT_PUBLIC_APP_NAME="OmniInvoice UAE"
NEXT_PUBLIC_APP_DESCRIPTION="Cloud-First UAE E-Invoicing & VAT Compliance SaaS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Application Secrets
NODE_ENV="development"
APP_SECRET="super-secure-production-ready-secret-change-in-prod-32bytes"
ENCRYPTION_KEY_AES256="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Database & Cache (Dockerized or Managed Cloud)
DATABASE_URL="postgresql://omni_user:omni_secure_pass_2026@localhost:5432/omni_invoicing_db?schema=public"
REDIS_URL="redis://localhost:6379"

# Accredited Service Provider (ASP) Integration
ASP_ENVIRONMENT="SANDBOX"
ASP_SANDBOX_API_URL="https://sandbox.asp.omni-einvoice.ae/v1"
ASP_API_KEY="asp_test_sandbox_secret_token"
ASP_WEBHOOK_SECRET="whsec_omni_test_secret_signature"

# UAE E-Invoicing Regulatory Specifications
COMPLIANCE_VERSION="PINT-AE-1.0"
DEFAULT_CURRENCY="AED"
DEFAULT_VAT_RATE="5.00"

# Storage Configuration (S3 / Private Local)
STORAGE_DRIVER="local" # "local" or "s3"
AWS_S3_BUCKET="omni-invoice-vault"
AWS_REGION="me-central-1" # UAE Dubai / Abu Dhabi
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
