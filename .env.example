# ==============================================================================
# OmniLedger UAE / OmniInvoice UAE - Environment Configuration Template
# All secrets and sensitive credentials MUST be provided via secure environment variables.
# NEVER commit real production credentials to version control.
# ==============================================================================

# Application Identity & URLs
NEXT_PUBLIC_APP_NAME="OmniLedger UAE"
NEXT_PUBLIC_APP_DESCRIPTION="UAE MoF & FTA Peppol PINT E-Invoicing & Dual-Entry Ledger SaaS"
NEXT_PUBLIC_APP_URL="https://omniledger-uae.netlify.app" # Production URL or http://localhost:3000 for local dev
NODE_ENV="development" # Set to "production" in production deployments

# Security & Session Secrets (MANDATORY IN PRODUCTION)
# APP_SECRET must be at least 32 cryptographically random characters
APP_SECRET="replace-with-at-least-32-chars-random-secret-for-production"
ENCRYPTION_KEY_AES256="replace-with-64-hex-chars-aes256-key-0123456789abcdef0123456789abcdef"

# PostgreSQL Database (MANDATORY FOR PERSISTENT PRODUCTION DATA)
# Used by Prisma ORM for transactional multi-tenant persistence
DATABASE_URL="postgresql://username:password@localhost:5432/omniledger_db?schema=public"

# Redis Cache & Distributed Rate Limiter (Optional for multi-instance, falls back in-memory)
REDIS_URL="redis://localhost:6379"

# ==============================================================================
# PayPal Gateway Configuration (Primary Payment Gateway)
# Configured for: ykamranali@outlook.com
# Obtain Client ID & Secret from: https://developer.paypal.com/dashboard/applications
# ==============================================================================
PAYPAL_MODE="sandbox" # "sandbox" for staging/dev, "live" for production transactions
PAYPAL_CLIENT_ID="your-paypal-rest-api-client-id-here"
PAYPAL_CLIENT_SECRET="your-paypal-rest-api-client-secret-here"
PAYPAL_WEBHOOK_ID="your-registered-paypal-webhook-id-here" # Generated when registering webhook in PayPal Developer Portal

# ==============================================================================
# Accredited Service Provider (ASP) Integration
# UAE Ministry of Finance (MoF) / FTA Certified Access Point Gateway
# ==============================================================================
ASP_ENVIRONMENT="SANDBOX" # "SANDBOX" (active mock) or "PRODUCTION" (requires accredited provider contract)
ASP_SANDBOX_API_URL="https://sandbox.asp.omni-einvoice.ae/v1"
ASP_API_KEY="asp_test_sandbox_secret_token"
ASP_WEBHOOK_SECRET="whsec_omni_test_secret_signature"

# ==============================================================================
# UAE E-Invoicing & Tax Regulatory Specifications
# ==============================================================================
COMPLIANCE_VERSION="PINT-AE-1.0"
DEFAULT_CURRENCY="AED"
DEFAULT_VAT_RATE="5.00"

# Storage Configuration (S3 / Private Local for XML & PDF Invoices)
STORAGE_DRIVER="local" # "local" or "s3"
AWS_S3_BUCKET="omni-invoice-vault"
AWS_REGION="me-central-1" # UAE (Dubai/Abu Dhabi)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
